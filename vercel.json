{
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "personaliza.praxisoperativa.com" }], "destination": "/panel", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/panel", "destination": "/personaliza.html" },
    { "source": "/superadmin", "destination": "/personaliza.html" },
    { "source": "/", "has": [{ "type": "host", "value": "feciega.com" }], "destination": "/tienda.html" },
    { "source": "/", "has": [{ "type": "host", "value": "www.feciega.com" }], "destination": "/tienda.html" },
    { "source": "/:path((?!api(?:/|$)|assets(?:/|$)|favicon\\.svg$|favicon\\.ico$).*)", "has": [{ "type": "host", "value": "feciega.com" }], "destination": "/tienda.html" },
    { "source": "/:path((?!api(?:/|$)|assets(?:/|$)|favicon\\.svg$|favicon\\.ico$).*)", "has": [{ "type": "host", "value": "www.feciega.com" }], "destination": "/tienda.html" },
    { "source": "/t/:slug", "destination": "/tienda.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/pago-exitoso", "destination": "/index.html" },
    { "source": "/pago-fallido", "destination": "/index.html" },
    { "source": "/pago-pendiente", "destination": "/index.html" }
  ]
}
